# =============================================================================
# G2 Tech Hub — Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha os valores necessários.
# Nenhuma dessas variáveis deve conter segredos versionados no repositório.
# =============================================================================

# --- URL pública do site (usada em metadata, sitemap e Open Graph) ----------
NEXT_PUBLIC_SITE_URL=https://www.g2techhub.com.br

# --- Formulário de contato ---------------------------------------------------
# Provedor a ser utilizado pelo endpoint /api/contact.
# Valores suportados: "mock" | "resend" | "formspree" | "hubspot" | "pipedrive" | "custom"
CONTACT_FORM_PROVIDER=mock

# Usado quando CONTACT_FORM_PROVIDER=resend
RESEND_API_KEY=
CONTACT_EMAIL_TO=contato@g2techhub.com.br
CONTACT_EMAIL_FROM=site@g2techhub.com.br

# Usado quando CONTACT_FORM_PROVIDER=formspree
FORMSPREE_FORM_ID=

# Usado quando CONTACT_FORM_PROVIDER=hubspot
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
HUBSPOT_ACCESS_TOKEN=

# Usado quando CONTACT_FORM_PROVIDER=pipedrive
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=

# Usado quando CONTACT_FORM_PROVIDER=custom
CONTACT_FORM_ENDPOINT=

# --- Analytics (opcionais — cada um só é ativado se a variável existir) ----
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Diagnóstico G2 -----------------------------------------------------------
# URL externa do formulário/ferramenta de diagnóstico, quando disponível.
NEXT_PUBLIC_DIAGNOSTIC_URL=
